[Unit]
Description=CERA Guest Agent
After=sysinit.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m cera_agent.main
WorkingDirectory=/opt/cera-agent
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/cera-agent:/opt/cera-agent/cera_agent
EnvironmentFile=-/opt/cera-agent/cera_agent/.env
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
